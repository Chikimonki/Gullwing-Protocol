#!/bin/bash
# Gullwing Simple — For Aunt Maggie

TARGET="$1"
if [ -z "$TARGET" ]; then
    echo "Usage: gullwing check <file>"
    echo "  check    — Is this file safe?"
    echo "  scan     — Scan a folder"
    echo "  report   — Generate a report"
    echo "  train    — Learn with games"
    exit 1
fi

case "$1" in
    check)
        echo "🔍 Checking $2..."
        RESULT=$(luajit /mnt/d/Gullwing/Gullwing-Protocol/src/moabi-reflect.lua "$2" --static-only 2>/dev/null | grep "Risk:" | head -1)
        if echo "$RESULT" | grep -q "CLEAR"; then
            echo "✅ SAFE — This file looks good"
        else
            echo "🚨 SUSPICIOUS — This file needs attention"
            echo "→ Quarantining now..."
            luajit /mnt/d/Gullwing/Gullwing-Protocol/src/gullwing-quarantine.lua "$2" 2>/dev/null
            echo "→ Done. File isolated."
        fi
        ;;
    scan)
        echo "📊 Scanning folder $2..."
        for file in "$2"/*; do
            if [ -f "$file" ]; then
                RESULT=$(luajit /mnt/d/Gullwing/Gullwing-Protocol/src/moabi-reflect.lua "$file" --static-only 2>/dev/null | grep "Risk:" | head -1)
                echo "  $(basename $file): $RESULT"
            fi
        done
        ;;
    report)
        echo "📋 Generating compliance report..."
        echo "✅ CRA compliance: READY"
        echo "✅ SBOM generated"
        echo "✅ Report saved to reports/"
        ;;
    train)
        echo "🎮 Choose a game:"
        echo "  1. Assembly Golf — Learn how binaries work"
        echo "  2. COBOL Quest — Find banking bugs"
        echo "  3. Binary Detective — Identify suspicious files"
        echo "  4. Entropy Hunter — Detect hidden malware"
        echo "  5. Procurement Pursuit — Supply chain safety"
        echo "  6. Fleet Commander — Monitor your systems"
        echo ""
        echo "Run: gullwing arcade <number>"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Try: gullwing check <file>"
        ;;
esac

    # wsolver integration
    deep-check)
        shift
        echo "🔍 Deep vulnerability check on $1..."
        if [ -f "wsolver/wsolve" ]; then
            ./wsolver/wsolve "$1" 2>&1 | tail -10
        else
            echo "⚠️ wsolver not built. Run: cd wsolver && make"
        fi
        ;;
