#!/usr/bin/env luajit
--============================================================================
--  MOABI-ML v3: 30‑Feature k‑NN Classifier
--  Structural ELF + Byte‑statistics + Library fingerprinting
--============================================================================

local LOG2 = math.log(2)
local WINDOW_SIZE = 1024
local EPSILON = 1e-10
local DEFAULT_K = 5

local FEATURE_NAMES = {
    "size_log", "entropy", "byte_mean", "byte_stddev", "null_ratio",
    "printable_ratio", "is_elf", "elf_class_num", "elf_type_num",
    "entropy_variance", "high_entropy_ratio", "low_entropy_ratio",
    "top_byte_ratio", "ff_ratio", "packer_detected",
    "section_count", "import_count", "export_count", "symbol_size", "has_debug",
    "has_libssl", "has_libcrypto", "has_libcurl", "has_libz", "has_lzma",
    "has_ncurses", "has_readline", "has_libpython", "has_libperl", "has_libruby",
}
local N_FEATURES = #FEATURE_NAMES

-- ============================================================================
--  UTILITIES
-- ============================================================================
local function entropy_from_hist(hist, total)
    if total <= 0 then return 0.0 end
    local e = 0.0
    for i = 0, 255 do
        local n = hist[i] or 0
        if n > 0 then
            local p = n / total
            e = e - p * (math.log(p) / LOG2)
        end
    end
    return e
end

-- ============================================================================
--  FEATURE EXTRACTION (FFI structural + Lua byte‑stats)
-- ============================================================================
local function extract_features(filepath)
    -- 1. Get structural features from FFI if available
    local struct = {
        section_count=0, import_count=0, export_count=0, symbol_size=0, has_debug=0,
        has_libssl=0, has_libcrypto=0, has_libcurl=0, has_libz=0, has_lzma=0,
        has_ncurses=0, has_readline=0, has_libpython=0, has_libperl=0, has_libruby=0,
    }
    local source = "lua-fallback"
    
    local ok_ffi, ffi2 = pcall(require, "moabi-ffi2")
    if ok_ffi and ffi2 and type(ffi2.extract_elf_features) == "function" then
        local ok, res = pcall(ffi2.extract_elf_features, filepath)
        if ok and res then
            struct = res
            source = "moabi-ffi2"
        end
    end

    -- 2. Get byte‑statistics (always read file for this)
    local f = io.open(filepath, "rb")
    if not f then return nil, "cannot open " .. filepath end
    local data = f:read("*a")
    f:close()
    if not data or #data == 0 then return nil, "empty file" end
    
    local size = #data
    local hist = {}
    for i = 0, 255 do hist[i] = 0 end
    local byte_sum, byte_sq = 0, 0
    local null_c, ff_c, print_c = 0, 0, 0
    
    for i = 1, size do
        local b = data:byte(i)
        hist[b] = hist[b] + 1
        byte_sum = byte_sum + b
        byte_sq = byte_sq + b * b
        if b == 0 then null_c = null_c + 1 end
        if b == 255 then ff_c = ff_c + 1 end
        if b >= 0x20 and b <= 0x7e then print_c = print_c + 1 end
    end
    
    local mean = byte_sum / size
    local var = math.max(0, byte_sq / size - mean * mean)
    local top = 0
    for i = 0, 255 do if hist[i] > top then top = hist[i] end end
    
    -- 3. Build feature dictionary
    local feat = {}
    feat.size_log = math.log(size + 1)
    feat.entropy = entropy_from_hist(hist, size)
    feat.byte_mean = mean
    feat.byte_stddev = math.sqrt(var)
    feat.null_ratio = null_c / size
    feat.printable_ratio = print_c / size
    feat.top_byte_ratio = top / size
    feat.ff_ratio = ff_c / size
    feat.packer_detected = (feat.entropy > 7.2 and feat.null_ratio < 0.05 and feat.printable_ratio < 0.10) and 1.0 or 0.0
    
    -- ELF header fields
    if size >= 5 and data:byte(1) == 0x7f and data:byte(2) == 0x45
       and data:byte(3) == 0x4c and data:byte(4) == 0x46 then
        feat.is_elf = 1.0
        feat.elf_class_num = 0.0 + data:byte(5)
        feat.elf_type_num = 0.0
        if size >= 18 then
            local ei = data:byte(6)
            if ei == 1 then
                feat.elf_type_num = 0.0 + data:byte(17) + data:byte(18) * 256
            elseif ei == 2 then
                feat.elf_type_num = 0.0 + data:byte(17) * 256 + data:byte(18)
            end
        end
    else
        feat.is_elf = 0.0
        feat.elf_class_num = 0.0
        feat.elf_type_num = 0.0
    end
    
    -- Windowed entropy
    local nw = math.floor(size / WINDOW_SIZE)
    if nw >= 2 then
        local w_ents = {}
        for w = 0, nw - 1 do
            local wh = {}
            for i = 0, 255 do wh[i] = 0 end
            local s = w * WINDOW_SIZE + 1
            for i = s, s + WINDOW_SIZE - 1 do
                local b = data:byte(i)
                wh[b] = wh[b] + 1
            end
            w_ents[#w_ents + 1] = entropy_from_hist(wh, WINDOW_SIZE)
        end
        local esum = 0; for _, v in ipairs(w_ents) do esum = esum + v end
        local emean = esum / #w_ents
        local evar, hi, lo = 0, 0, 0
        for _, v in ipairs(w_ents) do
            evar = evar + (v - emean) * (v - emean)
            if v > 7.0 then hi = hi + 1 end
            if v < 2.0 then lo = lo + 1 end
        end
        feat.entropy_variance = evar / #w_ents
        feat.high_entropy_ratio = hi / #w_ents
        feat.low_entropy_ratio = lo / #w_ents
    else
        feat.entropy_variance = 0.0
        feat.high_entropy_ratio = 0.0
        feat.low_entropy_ratio = 0.0
    end
    
    -- Merge structural features from FFI
    feat.section_count = struct.section_count or 0
    feat.import_count = struct.import_count or 0
    feat.export_count = struct.export_count or 0
    feat.symbol_size = struct.symbol_size or 0
    feat.has_debug = struct.has_debug or 0
    feat.has_libssl = struct.has_libssl or 0
    feat.has_libcrypto = struct.has_libcrypto or 0
    feat.has_libcurl = struct.has_libcurl or 0
    feat.has_libz = struct.has_libz or 0
    feat.has_lzma = struct.has_lzma or 0
    feat.has_ncurses = struct.has_ncurses or 0
    feat.has_readline = struct.has_readline or 0
    feat.has_libpython = struct.has_libpython or 0
    feat.has_libperl = struct.has_libperl or 0
    feat.has_libruby = struct.has_libruby or 0
    
    -- 4. Convert to vector (array) for k‑NN math
    local vec = {}
    for i = 1, N_FEATURES do
        vec[i] = feat[FEATURE_NAMES[i]] or 0.0
    end
    return vec, source
end

-- ============================================================================
--  MODEL CLASS
-- ============================================================================
local Model = {}
Model.__index = Model

function Model.new(k)
    local self = setmetatable({}, Model)
    self.k = k or DEFAULT_K
    self.samples = {}
    self.normalization = { mean = {}, std = {} }
    self.anomaly_threshold = math.huge
    self.info = {}
    return self
end

function Model:add_sample(vec, label, filename)
    self.samples[#self.samples + 1] = { vec = vec, label = label, filename = filename }
end

function Model:compute_normalization()
    local n = #self.samples
    if n == 0 then return end
    local sum, sumsq = {}, {}
    for i = 1, N_FEATURES do sum[i] = 0; sumsq[i] = 0 end
    for _, s in ipairs(self.samples) do
        for i = 1, N_FEATURES do
            local v = s.vec[i]
            sum[i] = sum[i] + v
            sumsq[i] = sumsq[i] + v * v
        end
    end
    for i = 1, N_FEATURES do
        local mean = sum[i] / n
        local var = math.max(0, sumsq[i] / n - mean * mean)
        local std = math.sqrt(var)
        if std < EPSILON then std = 1.0 end
        self.normalization.mean[i] = mean
        self.normalization.std[i] = std
    end
end

function Model:normalize(vec)
    local out = {}
    for i = 1, N_FEATURES do
        local m = self.normalization.mean[i] or 0.0
        local s = self.normalization.std[i] or 1.0
        if math.abs(s) < EPSILON then s = 1.0 end
        out[i] = (vec[i] - m) / s
    end
    return out
end

local function euclid(a, b)
    local s = 0.0
    for i = 1, N_FEATURES do
        local d = a[i] - b[i]
        s = s + d * d
    end
    return math.sqrt(s)
end

function Model:classify(vec)
    local nv = self:normalize(vec)
    local nbs = {}
    for i = 1, #self.samples do
        local sv = self:normalize(self.samples[i].vec)
        nbs[#nbs + 1] = {
            dist = euclid(nv, sv),
            label = self.samples[i].label,
            filename = self.samples[i].filename or "?"
        }
    end
    if #nbs == 0 then error("Model has no samples") end
    table.sort(nbs, function(a, b) return a.dist < b.dist end)
    
    local k = math.min(self.k or DEFAULT_K, #nbs)
    local scores, tw, sd = {}, 0.0, 0.0
    for i = 1, k do
        local w = 1.0 / (nbs[i].dist + EPSILON)
        scores[nbs[i].label] = (scores[nbs[i].label] or 0.0) + w
        tw = tw + w
        sd = sd + nbs[i].dist
    end
    
    local best_label, best_score = nil, -math.huge
    for lbl, sc in pairs(scores) do
        if sc > best_score then best_label, best_score = lbl, sc end
    end
    local conf = tw > 0 and (best_score / tw) * 100.0 or 0.0
    
    local class_dist, class_cnt = {}, {}
    for _, nb in ipairs(nbs) do
        class_dist[nb.label] = (class_dist[nb.label] or 0.0) + nb.dist
        class_cnt[nb.label] = (class_cnt[nb.label] or 0) + 1
    end
    for lbl, s in pairs(class_dist) do class_dist[lbl] = s / class_cnt[lbl] end
    
    local avg = sd / k
    local thresh = self.anomaly_threshold
    if self.info and self.info.anomaly_threshold then thresh = self.info.anomaly_threshold end
    
    local topk = {}
    for i = 1, k do topk[i] = nbs[i] end
    
    return {
        label = best_label,
        confidence = conf,
        neighbours = topk,
        k = k,
        class_distances = class_dist,
        avg_dist = avg,
        anomaly = avg > thresh,
        raw_vector = vec,
    }
end

-- ============================================================================
--  SERIALIZATION
-- ============================================================================
local function serialize(val)
    local t = type(val)
    if t == "nil" then return "nil"
    elseif t == "boolean" then return tostring(val)
    elseif t == "number" then
        if val ~= val then return "0/0"
        elseif val == math.huge then return "math.huge"
        elseif val == -math.huge then return "-math.huge" end
        return string.format("%.15g", val)
    elseif t == "string" then return string.format("%q", val)
    elseif t == "table" then
        local max_n, cnt = 0, 0
        for k in pairs(val) do
            if type(k) == "number" and k == math.floor(k) and k >= 1 then
                cnt = cnt + 1
                max_n = math.max(max_n, k)
            end
        end
        local is_arr = (cnt > 0 and == max_n and cnt == #val)
        local parts = {}
        if is_arr then
            for i = 1, #val do parts[i] = serialize(val[i]) end
            return "{" .. table.concat(parts, ",") .. "}"
        else
            local keys = {}
            for k in pairs(val) do keys[#keys + 1] = tostring(k) end
            table.sort(keys)
            for _, k in ipairs(keys) do parts[#parts + 1] = k .. "=" .. serialize(val[k]) end
            return "{" .. table.concat(parts, ",") .. "}"
        end
    end
    return "nil"
end

local function load_model(path)
    local chunk, err = loadfile(path)
    if not chunk then
        error("Cannot load (syntax): " .. path .. "\n" .. tostring(err))
    end
    local ok, model = pcall(chunk)
    if not ok then
        error("Cannot execute model: " .. path .. "\n" .. tostring(model))
    end
    if type(model) ~= "table" then
        error("Model is " .. type(model) .. ", expected table: " .. path)
    end
    if type(model.samples) ~= "table" then
        error("model.samples is " .. type(model.samples) .. " (file: " .. path .. ")")
    end
    if type(model.normalization) ~= "table" then
        error("model.normalization is " .. type(model.normalization) .. " (file: " .. path .. ")")
    end
    return setmetatable(model, Model)
end

local function save_model(model, path)
    local f = io.open(path, "w")
    if not f then error("Cannot write: " .. path) end
    f:write("-- MOABI-ML v3 model\n")
    f:write("return " .. serialize(model) .. "\n")
    f:close()
end

-- ============================================================================
--  COMMANDS
-- ============================================================================
local function cmd_train(train_dir, model_path)
    print("========================================")
    print("  MOABI-ML v3 Training (k-NN)")
    print("========================================")
    print()
    
    local model = Model.new()
    local class_counts = {}
    
    -- Scan directory
    local p = io.popen('ls -1 "' .. train_dir .. '"')
    if not p then error("Cannot list: " .. train_dir) end
    
    for cls in p:lines() do
        local cls_path = train_dir .. "/" .. cls
        local check = io.popen('test -d "' .. cls_path .. '" && echo 1')
        if check and check:read("*l") == "1" then
            check:close()
            local fp = io.popen('ls -1 "' .. cls_path .. '"')
            if fp then
                for fname in fp:lines() do
                    local fpath = cls_path .. "/" .. fname
                    local vec, src = extract_features(fpath)
                    if vec then
                        model:add_sample(vec, cls, fpath)
                        class_counts[cls] = (class_counts[cls] or 0) + 1
                    end
                end
                fp:close()
            end
        else
            if check then check:close() end
        end
    end
    p:close()
    
    local total = 0
    for _, n in pairs(class_counts) do total = total + n end
    
    if total < DEFAULT_K + 1 then error("Need at least " .. (DEFAULT_K + 1) .. " samples") end
    
    print("  Training " .. total .. " samples...")
    model:compute_normalization()
    
    -- Compute anomaly threshold from density
    local densities = {}
    for i = 1, #model.samples do
        local dists = {}
        for j = 1, #model.samples do
            if i ~= j then
                local a = model:normalize(model.samples[i].vec)
                local b = model:normalize(model.samples[j].vec)
                dists[#dists + 1] = euclid(a, b)
            end
        end
        table.sort(dists)
        local s = 0.0
        for d = 1, math.min(DEFAULT_K, #dists) do s = s + dists[d] end
        densities[i] = s / math.min(DEFAULT_K, #dists)
    end
    local dsum, dss = 0, 0
    for _, v in ipairs(densities) do dsum = dsum + v; dss = dss + v * v end
    local dmean = dsum / #densities
    local dvar = dss / #densities - dmean * dmean
    model.anomaly_threshold = dmean + 2.0 * math.sqrt(math.max(0, dvar))
    
    model.info = {
        version = 3,
        k = DEFAULT_K,
        n_features = N_FEATURES,
        n_samples = total,
        class_counts = class_counts,
        anomaly_threshold = model.anomaly_threshold,
    }
    
    save_model(model, model_path)
    print("  Model saved: " .. model_path)
    print(string.format("  Anomaly threshold: %.4f", model.anomaly_threshold))
    print()
end

local function cmd_validate(model_path, k_str)
    local k = tonumber(k_str) or DEFAULT_K
    local model = load_model(model_path)
    local n = #model.samples
    if n < k + 1 then error("Too few samples for k=" .. k) end
    
    -- Simple leave-one-out cross-validation
    local correct = 0
    local class_correct, class_total = {}, {}
    
    for i = 1, n do
        -- Build training set excluding i
        local train_model = Model.new(k)
        for j = 1, n do
            if j ~= i then
                train_model:add_sample(model.samples[j].vec, model.samples[j].label, model.samples[j].filename)
            end
        end
        train_model:compute_normalization()
        
        -- Classify left-out sample
        local true_label = model.samples[i].label
        local pred = train_model:classify(model.samples[i].vec)
        
        class_total[true_label] = (class_total[true_label] or 0) + 1
        if pred.label == true_label then
            correct = correct + 1
            class_correct[true_label] = (class_correct[true_label] or 0) + 1
        end
    end
    
    print("========================================")
    print("  MOABI-ML v3 Cross-Validation (LOO)")
    print("========================================")
    print()
    print(string.format("  Overall accuracy: %.1f%% (%d/%d)", correct / n * 100, correct, n))
    print()
    print("  Per-class:")
    for cls, tot in pairs(class_total) do
        local cor = class_correct[cls] or 0
        print(string.format("    %-20s %3d/%3d  %.1f%%", cls, cor, tot, cor / tot * 100))
    end
    print()
end

local function cmd_classify(model_path, target)
    local model = load_model(model_path)
    local vec, src = extract_features(target)
    if not vec then error("Cannot extract features from: " .. target) end
    
    local res = model:classify(vec)
    
    print("========================================")
    print("  MOABI-ML Classification")
    print("========================================")
    print("  Target:     " .. target)
    print("  Class:      " .. res.label)
    print(string.format("  Confidence: %.1f%%", res.confidence))
    print("  Anomaly:    " .. (res.anomaly and "YES" or "NO"))
    print(string.format("  Avg dist:   %.4f (threshold %.4f)", res.avg_dist, res.avg_dist > 0 and model.anomaly_threshold or 0))
    print()
    print("  Nearest neighbours:")
    for i = 1, math.min(5, res.k) do
        local nb = res.neighbours[i]
        print(string.format("    %d. %-20s d=%.4f %s", i, nb.label, nb.dist, nb.filename))
    end
end

-- ============================================================================
--  MAIN
-- ============================================================================
local function usage()
    print("MOABI-ML v3 — 30‑Feature k‑NN Classifier")
    print("Usage:")
    print("  moabi-ml.lua train   <training_dir> <model_output>")
    print("  moabi-ml.lua validate <model_file> [k]")
    print("  moabi-ml.lua classify <model_file> <target_file>")
end

local function main()
    local cmd = arg[1]
    if not cmd or cmd == "-h" or cmd == "--help" then usage(); return 0 end
    
    if cmd == "train" then
        if not arg[2] or not arg[3] then usage(); return 1 end
        cmd_train(arg[2], arg[3])
    elseif cmd == "validate" then
        if not arg[2] then usage(); return 1 end
        cmd_validate(arg[2], arg[3])
    elseif cmd == "classify" then
        if not arg[2] or not arg[3] then usage(); return 1 end
        cmd_classify(arg[2], arg[3])
    else
        print("Unknown command: " .. tostring(cmd))
        usage()
        return 1
    end
    return 0
end

local ok, ret = pcall(main)
if not ok then
    io.stderr:write("\nERROR: " .. tostring(ret) .. "\n")
    os.exit(1)
end
os.exit(ret or 0)
