#!/usr/bin/env luajit
--============================================================================
--  MOABI-QEMU v1.0 — Tier-2 Escalation Engine
--  Contained execution for HOSTILE/EXTREME binaries.
--============================================================================

local SRC = "/mnt/d/moabi/src"
package.path = SRC .. "/?.lua;" .. package.path

local ev = require("moabi-evidence")
local MF = require("moabi-features")

local LOG2 = math.log(2)
local M = {}

-- ============================================================================
--  QEMU BINARY RESOLUTION
-- ============================================================================
local QEMU_MAP = {
    x64     = { runner = "qemu-x86_64"  },
    amd64   = { runner = "qemu-x86_64"  },
    arm64   = { runner = "qemu-aarch64" },
    aarch64 = { runner = "qemu-aarch64" },
    riscv64 = { runner = "qemu-riscv64" },
}

local function shq(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end

local function which(cmd)
    local h = io.popen("which " .. shq(cmd) .. " 2>/dev/null")
    if not h then return nil end
    local r = h:read("*l"); h:close()
    return r and #r > 0 and r or nil
end

local function file_exists(p)
    local f = io.open(p, "rb"); if f then f:close(); return true end
    return false
end

local function detect_arch(target)
    local f = io.open(target, "rb")
    if not f then return nil end
    local h = f:read(20); f:close()
    if not h or #h < 20 then return nil end
    if h:byte(1) ~= 0x7f or h:byte(2) ~= 0x45 then return nil end

    local le = h:byte(6) == 1
    local machine = le and (h:byte(19) + h:byte(20) * 256)
                         or (h:byte(19) * 256 + h:byte(20))

    if machine == 62  then return "x64"
    elseif machine == 183 then return "arm64"
    elseif machine == 243 then return "riscv64"
    elseif machine == 3   then return "x86"
    elseif machine == 40  then return "arm"
    end
    return "unknown"
end

