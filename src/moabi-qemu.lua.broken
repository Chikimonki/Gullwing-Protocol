-- ============================================================================
--  CONTAINED EXECUTION
-- ============================================================================
local function run_contained(target, opts)
    opts = opts or {}
    local arch = opts.arch or detect_arch(target) or "x64"
    local timeout = opts.timeout or 5
    local qemu_cfg = QEMU_MAP[arch]

    local result = {
        arch = arch,
        contained = false,
        native_fallback = false,
        syscalls = {},
        total_syscalls = 0,
        syscall_entropy = 0,
        memory_entropy = nil,
        instruction_count = 0,
        exit_code = nil,
        error = nil,
        net_count = 0,
        file_count = 0,
        exec_count = 0,
    }

    local runner = qemu_cfg and which(qemu_cfg.runner) or nil
    local workspace = os.tmpname() .. ".moabi-qemu"
    os.execute("mkdir -p " .. shq(workspace))

    local trace_file = workspace .. "/trace"
    local log_file = workspace .. "/qemu.log"
    local stdout_file = workspace .. "/stdout"

    if runner then
        result.contained = true
        local cmd = string.format(
            "timeout %ds %s -strace -d exec -D %s %s >%s 2>&1; echo $? > %s/exit",
            timeout, runner, shq(log_file), shq(target),
            shq(stdout_file), shq(workspace)
        )
        os.execute(cmd)

        local ef = io.open(workspace .. "/exit", "r")
        if ef then result.exit_code = tonumber(ef:read("*l")); ef:close() end

        local sf = io.open(stdout_file, "r")
        if sf then
            for line in sf:lines() do
                local sc = line:match("^(%a[%w_]*)")
                if sc then
                    result.syscalls[sc] = (result.syscalls[sc] or 0) + 1
                    result.total_syscalls = result.total_syscalls + 1
                end
            end
            sf:close()
        end

        local lf = io.open(log_file, "r")
        if lf then
            local insn_count = 0
            for line in lf:lines() do
                if line:find("Trace 0x") then insn_count = insn_count + 1 end
            end
            lf:close()
            result.instruction_count = insn_count
        end
    else
        result.native_fallback = true
        local cmd = string.format(
            "timeout %ds strace -f -qq -o %s -- %s >/dev/null 2>&1",
            timeout, shq(trace_file), shq(target)
        )
        os.execute(cmd)

        local tf = io.open(trace_file, "r")
        if tf then
            for line in tf:lines() do
                local sc = line:match("^%s*%d+%s+([%a_][%w_]*)%(")
                    or line:match("^%s*([%a_][%w_]*)%(")
                if sc then
                    result.syscalls[sc] = (result.syscalls[sc] or 0) + 1
                    result.total_syscalls = result.total_syscalls + 1
                end
            end
            tf:close()
        end
    end

    -- Compute entropy
    if result.total_syscalls > 0 then
        local e = 0
        for _, n in pairs(result.syscalls) do
            local p = n / result.total_syscalls
            e = e - p * (math.log(p) / LOG2)
        end
        result.syscall_entropy = e
    end

    -- Categorize
    local net_sc = {socket=1,connect=1,accept=1,bind=1,listen=1,sendto=1,recvfrom=1}
    local fil_sc = {open=1,openat=1,read=1,write=1,close=1,stat=1,fstat=1}
    for sc, n in pairs(result.syscalls) do
        if net_sc[sc] then result.net_count = result.net_count + n end
        if fil_sc[sc] then result.file_count = result.file_count + n end
    end
    result.exec_count = result.syscalls.execve or 0

    os.execute("rm -rf " .. shq(workspace))
    return result
end

-- ============================================================================
--  ESCALATION API
-- ============================================================================
function M.escalate(target, opts)
    opts = opts or {}
    local result = {
        target = target,
        tier = 2,
        trigger = opts.trigger or "manual",
        signals = {},
        total_syscalls = 0,
        syscall_entropy = 0,
        net_count = 0,
        file_count = 0,
        exec_count = 0,
        contained = false,
        native_fallback = false,
        tier2_verdict = "TIER-2 UNKNOWN",
    }

    local arch = opts.arch or detect_arch(target) or "x64"
    local qemu_cfg = QEMU_MAP[arch]
    local has_qemu = qemu_cfg and which(qemu_cfg.runner) ~= nil

    result.arch = arch
    result.qemu_available = has_qemu
    result.qemu_binary = has_qemu and which(qemu_cfg.runner) or nil

    if not is_runnable(target) then
        result.not_executable = true
        result.error = "target is a library / relocatable object — Tier-2 execution skipped"
        result.signals[#result.signals + 1] = 
            "not a runnable binary (library/object) — Tier-2 execution skipped"
        result.tier2_verdict = "TIER-2 N/A (static artifact)"
        return result
    end

    local exec_result = run_contained(target, {
        arch = arch,
        timeout = opts.timeout or 5,
    })

    result.contained = exec_result.contained
    result.native_fallback = exec_result.native_fallback
    result.total_syscalls = exec_result.total_syscalls or 0
    result.syscall_entropy = exec_result.syscall_entropy or 0
    result.net_count = exec_result.net_count or 0
    result.file_count = exec_result.file_count or 0
    result.exec_count = exec_result.exec_count or 0
    result.exit_code = exec_result.exit_code
    result.instruction_count = exec_result.instruction_count or 0

    -- Signal generation (nil-safe)
    if (exec_result.total_syscalls or 0) == 0 and exec_result.exit_code ~= 0 then
        result.signals[#result.signals + 1] = "binary crashed or refused to execute under containment"
    end
    if (exec_result.exec_count or 0) > 1 then
        result.signals[#result.signals + 1] = "re-execution detected (" .. exec_result.exec_count .. " execve calls)"
    end
    if (exec_result.net_count or 0) > 0 and not has_qemu then
        result.signals[#result.signals + 1] = "network activity from uncontained execution (RISK: actual network access)"
    end
    if (exec_result.net_count or 0) > 0 and has_qemu then
        result.signals[#result.signals + 1] = "network syscalls attempted under containment (blocked by QEMU)"
    end
    if (exec_result.instruction_count or 0) > 100000 then
        result.signals[#result.signals + 1] = string.format(
            "high instruction count (%d traces) — complex or obfuscated execution",
            exec_result.instruction_count)
    end
    if (exec_result.instruction_count or 0) < 10 and (exec_result.total_syscalls or 0) < 5 then
        result.signals[#result.signals + 1] = "minimal execution — possible stub or dropper"
    end

    if #result.signals > 2 then
        result.tier2_verdict = "CONFIRMED HOSTILE"
    elseif #result.signals > 0 then
        result.tier2_verdict = "ESCALATED SUSPICIOUS"
    else
        result.tier2_verdict = "TIER-2 CLEAR"
    end

    return result
end

-- ============================================================================
--  REPORT
-- ============================================================================
function M.print_report(result)
    local line = string.rep("=", 64)
    print(line)
    print("  MOABI TIER-2 ESCALATION REPORT (QEMU)")
    print(line)
    print()
    print("  Target:        " .. tostring(result.target))
    print("  Architecture:  " .. tostring(result.arch))
    print("  QEMU:          " .. (result.qemu_available and ("yes (" .. tostring(result.qemu_binary) .. ")") or "no (native strace fallback)"))
    print("  QEMU user-mode:     " .. tostring(result.contained))
    print("  Runnable:      " .. tostring(not result.not_executable))
    print()
    print("  Syscalls:      " .. tostring(result.total_syscalls or 0))
    print(string.format("  Entropy:       %.4f", result.syscall_entropy or 0))
    print("  Network:       " .. tostring(result.net_count or 0))
    print("  File I/O:      " .. tostring(result.file_count or 0))
    print("  execve:        " .. tostring(result.exec_count or 0))
    if result.instruction_count and result.instruction_count > 0 then
        print("  Instructions:  " .. tostring(result.instruction_count))
    end
    if result.exit_code then
        print("  Exit code:     " .. tostring(result.exit_code))
    end
    print()
    print("  Tier-2 Verdict: " .. tostring(result.tier2_verdict or "TIER-2 UNKNOWN"))
    if #result.signals > 0 then
        print("  Signals:")
        for _, s in ipairs(result.signals) do
            print("    - " .. s)
        end
    end
    print()
    print(line)
end

-- ============================================================================
--  CLI
-- ============================================================================
if arg and arg[1] then
    local target = arg[1]
    if not file_exists(target) then
        io.stderr:write("Not found: " .. target .. "\n")
        os.exit(1)
    end

    local opts = { timeout = 5 }
    local i = 2
    while i <= #arg do
        if arg[i] == "--arch" and arg[i+1] then
            opts.arch = arg[i+1]; i = i + 2
        elseif arg[i] == "--timeout" and arg[i+1] then
            opts.timeout = tonumber(arg[i+1]) or 5; i = i + 2
        else
            i = i + 1
        end
    end

    local result = M.escalate(target, opts)
    M.print_report(result)
end

return M
